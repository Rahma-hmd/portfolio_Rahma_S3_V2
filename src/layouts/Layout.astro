---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "aos/dist/aos.css";

const {
  title = "Portfolio — Rahma Hamdi",
  description = "Portfolio de Rahma Hamdi, étudiante en BUT MMI : stratégie de communication, création de contenus et web.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=Press+Start+2P&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <script>
      import AOS from "aos";
      AOS.init({ duration: 500, once: true, offset: 60 });
    </script>
  </body>
</html>
