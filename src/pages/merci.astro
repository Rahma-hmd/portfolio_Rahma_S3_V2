---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Message envoyé — Rahma Hamdi">
  <section class="container section merci">
    <p class="label">Message envoyé</p>
    <h1>Merci !</h1>
    <p>Votre message est bien parti. Je vous réponds dès que possible.</p>
    <a href="/" class="pixel-btn">Retour à l'accueil →</a>
  </section>
</Layout>

<style>
  .merci {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
</style>
