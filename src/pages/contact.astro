---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact | Rahma Hamdi">
  <section class="container section">
    <p class="label">Contact</p>
    <h1>Me contacter</h1>
    <p class="intro">Une question, un projet ou une opportunité ? Remplissez ce formulaire.</p>

    <form
      class="formulaire pixel-panel pixel-panel--orange"
      name="contact"
      method="POST"
      action="/merci/"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-aos="fade-up"
    >
      <!-- Champ piège anti-spam : invisible pour les visiteurs, rempli par les robots -->
      <p hidden>
        <label>Ne pas remplir : <input name="bot-field" /></label>
      </p>

      <div class="duo">
        <div class="champ">
          <label for="prenom">Prénom</label>
          <input id="prenom" name="prenom" type="text" autocomplete="given-name" required />
        </div>
        <div class="champ">
          <label for="nom">Nom</label>
          <input id="nom" name="nom" type="text" autocomplete="family-name" required />
        </div>
      </div>

      <div class="champ">
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" autocomplete="email" required />
      </div>

      <div class="champ">
        <label for="objet">Objet</label>
        <input id="objet" name="objet" type="text" required />
      </div>

      <div class="champ">
        <label for="message">Message</label>
        <textarea id="message" name="message" rows="6" required></textarea>
      </div>

      <button type="submit" class="pixel-btn pixel-btn--sombre">Envoyer →</button>
    </form>
  </section>
</Layout>

<style>
  h1 {
    margin-block: 0.75rem 1rem;
  }

  .intro {
    margin-bottom: 2.5rem;
  }

  .formulaire {
    max-width: 720px;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .duo {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .duo { grid-template-columns: 1fr 1fr; }
  }

  .champ {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.75rem;
    font-family: var(--font-texte);
    font-size: 1rem;
    color: var(--brun);
    background: var(--creme);
    border: 3px solid var(--brun);
    border-radius: 0;
  }

  textarea {
    resize: vertical;
  }

  .formulaire :focus-visible {
    outline-color: var(--brun);
    outline-offset: 3px;
  }

  button {
    align-self: flex-start;
  }
</style>
 