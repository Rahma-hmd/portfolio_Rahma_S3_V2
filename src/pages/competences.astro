---
import Layout from "../layouts/Layout.astro";

/* ---------- Les 5 compétences du BUT MMI ---------- */
const domaines = [
  {
    nom: "Comprendre",
    description: "Analyser un marché, des utilisateurs et leurs besoins.",
    competences: [
      "Étude de marché et analyse de la concurrence",
      "Création de personas",
      "Analyse des besoins réels (entretiens)",
      "Veille digitale",
    ],
  },
  {
    nom: "Concevoir",
    description: "Imaginer une réponse adaptée à un besoin.",
    competences: [
      "Stratégie de communication (messages clés, plan de diffusion)",
      "Communication et promotion de marque",
      "Gestion des réseaux sociaux",
      "Traduction des besoins en fonctionnalités",
    ],
  },
  {
    nom: "Exprimer",
    description: "Faire passer un message avec les médias numériques.",
    competences: [
      "Création de contenu photo et vidéo",
      "Création de contenus courts",
      "Montage vidéo",
      "Retouche photo",
      "Prise de son au micro professionnel",
      "Installation d'un éclairage professionnel",
      "Identité visuelle",
      "Création d'affiches",
      "Visuels pour réseaux sociaux",
      "Mise en page print et numérique",
    ],
  },
  {
    nom: "Développer",
    description: "Réaliser des sites et des interfaces web.",
    competences: [
      "Intégration HTML et CSS natif",
      "Site statique avec Astro",
      "Animations au scroll (AOS, GSAP)",
    ],
  },
  {
    nom: "Entreprendre",
    description: "Travailler en équipe et organiser un projet.",
    competences: [
      "Travail en équipe de trois",
      "Organisation d'un projet (planning, répartition des tâches)",
    ],
  },
];

/* ---------- Les outils (images dans public/images/outils/) ---------- */
const outils = [
  { nom: "Illustrator", image: "/images/outils/illustrator.png" },
  { nom: "Photoshop", image: "/images/outils/photoshop.png" },
  { nom: "Figma", image: "/images/outils/figma.png" },
  { nom: "Canva", image: "/images/outils/canva.png" },
  { nom: "DaVinci Resolve", image: "/images/outils/davinci-resolve.png" },
];

/* Nombre de compétences affichées en même temps dans une carte */
const PAR_PAGE = 4;

/* Découpe une liste en paquets de 4 :
   [a, b, c, d, e, f] devient [[a, b, c, d], [e, f]] */
const decouper = (liste) => {
  const pages = [];
  for (let i = 0; i < liste.length; i += PAR_PAGE) {
    pages.push(liste.slice(i, i + PAR_PAGE));
  }
  return pages;
};

/* Transforme 0, 1, 2 en "01", "02", "03" */
const numero = (i) => String(i + 1).padStart(2, "0");
---

<Layout title="Compétences | Rahma Hamdi">
  <div class="container">

    <!-- EN-TÊTE -->
    <section class="section">
      <p class="label">Compétences</p>
      <h1 class="competences-titre">Mes compétences</h1>
    </section>

    <!-- LES 5 DOMAINES -->
    <section class="section">
      <div class="competences-grille">
        {domaines.map((domaine, i) => {
          const pages = decouper(domaine.competences);
          return (
            <article class="pixel-panel domaine">
              <span class="domaine__num">{numero(i)}</span>
              <h2>{domaine.nom}</h2>
              <p>{domaine.description}</p>

              <!-- Les paquets de compétences : un seul est visible à la fois -->
              <div class="domaine__pages">
                {pages.map((page, p) => (
                  <ul class={p === 0 ? "domaine__page est-active" : "domaine__page"}>
                    {page.map((competence) => (
                      <li>{competence}</li>
                    ))}
                  </ul>
                ))}
              </div>

              <!-- Le bouton n'existe que s'il y a plus de 4 compétences -->
              {pages.length > 1 && (
                <button class="domaine__suite" type="button">
                  ▼ Suite <span class="domaine__compteur">1/{pages.length}</span>
                </button>
              )}
            </article>
          );
        })}
      </div>
    </section>

    <!-- LES OUTILS -->
    <section class="section">
      <h2 class="competences-h2">Outils que je sais utiliser</h2>

      <ul class="outils">
        {outils.map((outil) => (
          <li class="outil">
            <img src={outil.image} alt="" width="56" height="56" />
            <span>{outil.nom}</span>
          </li>
        ))}
      </ul>
    </section>

    <!-- LIEN VERS LES PROJETS -->
    <section class="section">
      <a class="pixel-btn" href="/projets">Voir mes projets</a>
    </section>

  </div>
</Layout>

<script>
  /* Pour chaque carte : le bouton affiche le paquet de compétences suivant */
  document.querySelectorAll(".domaine").forEach((carte) => {
    const bouton = carte.querySelector(".domaine__suite");
    if (!bouton) return; // pas de bouton : la carte n'a qu'un seul paquet

    const pages = carte.querySelectorAll(".domaine__page");
    const compteur = carte.querySelector(".domaine__compteur");
    let actuelle = 0;

    bouton.addEventListener("click", () => {
      pages[actuelle].classList.remove("est-active");
      actuelle = (actuelle + 1) % pages.length; // après le dernier, retour au premier
      pages[actuelle].classList.add("est-active");
      compteur.textContent = `${actuelle + 1}/${pages.length}`;
    });
  });
</script>

<style>
  .competences-titre {
    margin: 0.75rem 0 1rem;
    font-family: var(--font-pixel);
    font-size: clamp(1.3rem, 3.5vw, 2rem);
    line-height: 1.3;
    color: var(--orange);
    text-shadow: 3px 3px 0 var(--brun);
  }

  .competences-h2 {
    margin-bottom: 1.5rem;
    font-family: var(--font-pixel);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--creme);
  }

  /* ---------- Cartes des domaines ---------- */
  .competences-grille {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    grid-auto-rows: 1fr; /* toutes les lignes ont la même hauteur */
    gap: 1.75rem;
  }

  .domaine {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    transition: transform 0.15s steps(3), box-shadow 0.15s steps(3);
  }

  /* Au survol : la carte se soulève et son ombre grandit */
  .domaine:hover {
    transform: translate(-4px, -4px);
    box-shadow: 8px 8px 0 var(--orange);
  }

  .domaine:hover h2 {
    color: var(--orange);
  }

  .domaine__num {
    font-family: var(--font-pixel);
    font-size: 0.7rem;
    color: var(--orange);
  }

  .domaine h2 {
    margin: 0.7rem 0 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--creme);
  }

  .domaine p {
    margin: 0 0 0.8rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--orange-clair);
  }

  /* Les paquets sont superposés dans la même case :
     la carte garde toujours la hauteur du paquet le plus long */
  .domaine__pages {
    display: grid;
    margin-bottom: 1rem;
  }

  .domaine__page {
    grid-area: 1 / 1;
    visibility: hidden;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .domaine__page.est-active {
    visibility: visible;
  }

  .domaine__page li {
    padding: 0.5rem 0;
    border-top: 2px dashed var(--brun);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Bouton "Suite", toujours collé en bas de la carte */
  .domaine__suite {
    margin-top: auto;
    align-self: flex-start;
    padding: 0.5rem 0.7rem;
    background: var(--orange);
    border: 0;
    box-shadow: 3px 3px 0 var(--creme);
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    color: var(--noir);
    cursor: pointer;
  }

  .domaine__suite:hover {
    background: var(--creme);
    box-shadow: 3px 3px 0 var(--orange);
  }

  .domaine__suite:focus-visible {
    outline: 3px solid var(--creme);
    outline-offset: 3px;
  }

  /* ---------- Outils ---------- */
  .outils {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outil {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    width: 130px;
    padding: 1rem 0.5rem;
    background: var(--fond-carte);
    border: 3px solid var(--brun);
    transition: transform 0.15s steps(3), border-color 0.15s steps(3);
  }

  .outil:hover {
    transform: translateY(-4px);
    border-color: var(--orange);
  }

  .outil img {
    width: 56px;
    height: 56px;
    object-fit: contain;
    image-rendering: pixelated; /* garde les pixels nets */
  }

  .outil span {
    font-family: var(--font-pixel);
    font-size: 0.5rem;
    line-height: 1.6;
    text-align: center;
    color: var(--creme);
  }

  /* Pas d'animation pour les personnes qui les ont désactivées */
  @media (prefers-reduced-motion: reduce) {
    .domaine,
    .outil {
      transition: none;
    }
  }
</style>
