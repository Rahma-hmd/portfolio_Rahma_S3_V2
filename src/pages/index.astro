---
import Layout from "../layouts/Layout.astro";
import ProjectBarrel from "../components/ProjectBarrel.astro";
---

<Layout title="Rahma Hamdi | Portfolio">
  <!-- HERO -->
  <section class="hero container">
    <span class="pixel-star" style="top: 12%; left: 8%;"></span>
    <span class="pixel-star" style="top: 30%; right: 6%;"></span>
    <span class="pixel-star" style="bottom: 10%; left: 18%;"></span>

    <div class="pixel-onglet hero__onglet">
      <span class="pixel-onglet__titre">PLAYER 1</span>
      <div class="hero__panel pixel-panel pixel-panel--orange">
        <h1>Rahma Hamdi</h1>
        <a href="#presentation" class="pixel-btn pixel-btn--sombre">Continuer →</a>
        <p class="hero__clignote">▶ Press start</p>
      </div>
    </div>
  </section>

  <!-- PRÉSENTATION -->
  <section id="presentation" class="container section" data-aos="fade-up">
    <p class="label">Présentation</p>
    <h2>Bonjour, moi c'est Rahma</h2>
    <div class="texte">
      <p>
        Étudiante en BUT MMI, je conçois des stratégies de communication digitale et je
        les fais vivre : de l'analyse du besoin à la création des supports, en passant
        par les réseaux sociaux, le contenu et le web.
      </p>
      <p>
        Pour moi, une com n'a de valeur que si elle répond à un objectif et touche la
        bonne cible. Découvrez mes projets et ma démarche, de l'idée jusqu'au résultat.
      </p>
    </div>
  </section>

  <div class="container"><div class="pixel-divider"></div></div>

  <!-- PROJETS -->
  <section class="container section">
    <p class="label">Sélection</p>
    <h2>Projets</h2>

    <ProjectBarrel />
  </section>

  <div class="container"><div class="pixel-divider"></div></div>

  <!-- À PROPOS -->
  <section class="container section apropos-accueil" data-aos="fade-up">
    <p class="label">Qui suis-je ?</p>
    <h2>À propos</h2>

    <div class="pixel-onglet apropos-accueil__onglet">
      <span class="pixel-onglet__titre">RAHMA.PNG</span>
      <div class="pixel-onglet__cadre">
        <img
          src="/images/accueil-apropos.png"
          alt="Illustration pixel art de Rahma avec un café, un ordinateur portable et une chaise de bureau"
          width="561"
          height="494"
          loading="lazy"
          class="apropos-accueil__image"
        />
      </div>
    </div>

    <a href="/a-propos" class="pixel-btn">En savoir plus →</a>
  </section>

  <div class="container"><div class="pixel-divider"></div></div>

  <!-- COMPÉTENCES -->
  <section class="container section" data-aos="fade-up">
    <p class="label">Profil</p>
    <h2>Compétences</h2>
    
    <a href="/competences" class="pixel-btn">Voir mes compétences →</a>
  </section>

  <!-- CONTACT -->
  <section class="container section contact" data-aos="fade-up">
    <h2>Contact</h2>
    <p>Une question, un projet ou une opportunité ? Écrivez-moi.</p>
    <a href="/contact" class="pixel-btn">Me contacter →</a>
  </section>
</Layout>

<style>
  /* ---------- Onglet 8 bits : une étiquette posée sur un cadre ---------- */
  .pixel-onglet__titre {
    display: block;
    width: fit-content;
    padding: 0.5rem 0.8rem;
    background: var(--creme);
    font-family: var(--font-pixel);
    font-size: 0.55rem;
    color: var(--noir);
  }

  /* Cadre utilisé autour de l'image "À propos" */
  .pixel-onglet__cadre {
    padding: 1rem;
    background: var(--fond-carte);
    border: 3px solid var(--creme);
    box-shadow: 6px 6px 0 var(--orange);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero__onglet {
    max-width: 760px;
    margin-inline: auto;
  }

  .hero__panel {
    padding: clamp(2.5rem, 6vw, 4.5rem) 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .hero h1 {
    text-shadow: 3px 3px 0 var(--creme);
  }

  .hero__clignote {
    font-family: var(--font-pixel);
    font-size: 0.625rem;
    animation: clignote 1.2s steps(1) infinite;
  }

  @keyframes clignote {
    50% { opacity: 0; }
  }

  /* ---------- Sections ---------- */
  h2 {
    margin-block: 0.5rem 1.5rem;
  }

  .texte {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* ---------- À propos ---------- */
  .apropos-accueil {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .apropos-accueil h2 {
    margin: 0;
  }

  .apropos-accueil__onglet {
    width: min(100%, 480px);
  }

  .apropos-accueil__image {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Compétences ---------- */
  .parcours {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 2rem;
    list-style: none;
  }

  .parcours li {
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .parcours li:not(:last-child)::after {
    content: " →";
    color: var(--orange);
  }

  /* ---------- Contact ---------- */
  .contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
</style>
