---
import Layout from "../../layouts/Layout.astro";

const missions = ["Étude de marché", "Veille", "Réseaux sociaux", "Stratégie de communication"];

const demarche = [
  "Étude de marché",
  "Veille",
  "Analyse des cibles",
  "Stratégie éditoriale",
  "Planning réseaux sociaux",
  "Création de contenus",
];

const competences = [
  { titre: "Veille", texte: "Analyse des tendances, des concurrents, des formats et des prises de parole du secteur." },
  { titre: "Étude de marché", texte: "Analyse du marché, des acteurs, des cibles et des opportunités." },
  { titre: "Stratégie de communication", texte: "Définition du positionnement, des objectifs et des piliers éditoriaux." },
  { titre: "Communication digitale", texte: "Adaptation des contenus et des messages aux différents réseaux sociaux." },
  { titre: "Création de contenu", texte: "Conception de carrousels, de contenus pédagogiques et de publications de sensibilisation." },
  { titre: "Analyse des cibles", texte: "Identification des besoins et des attentes des différents publics." },
  { titre: "Planification éditoriale", texte: "Définition des fréquences de publication et organisation des contenus." },
  { titre: "Créativité", texte: "Transformation de sujets complexes en contenus simples, visuels et engageants." },
];
---

<Layout title="ZOZZO — Rahma Hamdi">
  <!-- EN-TÊTE DU PROJET -->
  <section class="container section entete">
    <div class="entete__panel pixel-panel pixel-panel--orange">
      <p class="entete__label">Projet collectif · Web app LSF</p>
      <h1>ZOZZO</h1>
      <div class="liens">
        <a href="#" target="_blank" rel="noopener">ZOZZO.fr ↗</a>
        <a href="#" target="_blank" rel="noopener">Instagram ↗</a>
      </div>
    </div>
  </section>

  <!-- PRÉSENTATION -->
  <section class="container bloc" data-aos="fade-up">
    <h2>Présentation</h2>
    <p>
      ZOZZO est un projet collectif autour de la langue des signes française et de la
      sensibilisation à l'inclusion des personnes sourdes et malentendantes.
    </p>
    <p>
      Mon objectif était d'analyser le marché existant, de lister les concurrents, de
      trouver comment se différencier des autres applications et de créer une stratégie
      de communication avec des cibles bien précises.
    </p>
  </section>

  <!-- MISSIONS -->
  <section class="container bloc" data-aos="fade-up">
    <h2>Mes missions</h2>
    <ul class="badges">
      {missions.map((mission) => <li>{mission}</li>)}
    </ul>
  </section>

  <!-- CONTEXTE -->
  <section class="container bloc" data-aos="fade-up">
    <h2>Contexte</h2>
    <p>
      Avant de créer les contenus, j'ai travaillé sur l'environnement du projet afin de
      comprendre le marché, les concurrents, les cibles et les tendances de
      communication.
    </p>
    <p>
      Cette analyse m'a permis de définir un positionnement plus clair et d'identifier
      les sujets les plus pertinents à mettre en avant.
    </p>
  </section>

  <!-- DÉMARCHE -->
  <section class="container bloc">
    <h2 data-aos="fade-up">Ma démarche</h2>
    <ol class="etapes">
      {demarche.map((etape, index) => (
        <li class="etape pixel-panel" data-aos="fade-up" data-aos-delay={index * 80}>
          <span class="etape__numero">{String(index + 1).padStart(2, "0")}</span>
          <span>{etape}</span>
        </li>
      ))}
    </ol>
  </section>

  <!-- RÉSULTAT -->
  <section class="container bloc" data-aos="fade-up">
    <h2>Résultat</h2>
    <p>
      Le projet a abouti à une stratégie de communication complète : étude de marché,
      veille, positionnement, piliers éditoriaux, planning de publication et concepts
      de contenus.
    </p>
    <p>
      Ce projet montre ma capacité à partir d'une analyse stratégique pour aller jusqu'à
      la création de supports de communication concrets.
    </p>
  </section>

  <!-- COMPÉTENCES MOBILISÉES -->
  <section class="container bloc">
    <h2 data-aos="fade-up">Compétences mobilisées</h2>
    <ul class="competences">
      {competences.map((comp) => (
        <li data-aos="fade-up">
          <h3>{comp.titre}</h3>
          <p>{comp.texte}</p>
        </li>
      ))}
    </ul>
  </section>

  <!-- NAVIGATION -->
  <section class="container section navigation">
    <a href="/projets" class="pixel-btn">← Tous les projets</a>
    <a href="/competences" class="pixel-btn">Mes compétences →</a>
  </section>
</Layout>

<style>
  .entete__panel {
    padding: clamp(2rem, 5vw, 3.5rem) 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .entete__label {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .entete h1 {
    text-shadow: 3px 3px 0 var(--creme);
  }

  .liens {
    display: flex;
    gap: 1.5rem;
    font-weight: 600;
  }

  .bloc {
    padding-block: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .bloc h2 {
    color: var(--orange);
    margin-bottom: 0.5rem;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
  }

  .badges li {
    padding: 0.5rem 0.75rem;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    border: 3px solid var(--orange);
  }

  .etapes {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    list-style: none;
  }

  @media (min-width: 640px) {
    .etapes { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .etapes { grid-template-columns: repeat(3, 1fr); }
  }

  .etape {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
  }

  .etape__numero {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    color: var(--orange);
  }

  .competences {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem 3rem;
    list-style: none;
  }

  @media (min-width: 760px) {
    .competences { grid-template-columns: 1fr 1fr; }
  }

  .competences h3 {
    font-size: 0.8125rem;
    color: var(--orange);
    margin-bottom: 0.4rem;
  }

  .competences p {
    font-size: 0.95rem;
    opacity: 0.85;
  }

  .navigation {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
</style>
