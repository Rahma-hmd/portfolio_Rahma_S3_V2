---
import Layout from "../../layouts/Layout.astro";
import "../../styles/projet.css";

/* ---------- Données du projet ---------- */
const projet = {
  nom: "ZOZZO",
  type: "Projet collectif · Web app LSF",
  accroche:
    "Un projet collectif pour faire découvrir la langue des signes française et sensibiliser à l'inclusion.",
  presentation:
    "ZOZZO est un projet de plateforme éducative et ludique qui initie les enfants à la Langue des Signes Française (LSF). À travers des histoires interactives, des mini-jeux et un univers illustré, notre objectif est de rendre l’apprentissage de la LSF accessible et amusant, tout en sensibilisant les enfants à l’inclusion et à la culture sourde.",
  lien: "https://zozzo.fr/",
  instagram: "https://www.instagram.com/zozzolsf/",
};

const infos = [
  { label: "Cadre", valeur: "Projet personnelle" },
  { label: "Équipe", valeur: "Rahma HAMDI, Nargis AYYOBI et Noémie CARITEY" },
  { label: "Mon rôle", valeur: "Étude de marché, veille, stratégie de communication" },
];

const missions = [
  {
    titre: "Étude de marché",
    texte: "Analyse du marché, des acteurs, des cibles et des opportunités.",
  },
  {
    titre: "Veille",
    texte:
      "Suivi des tendances, des concurrents, des formats et des prises de parole du secteur.",
  },
  {
    titre: "Stratégie de communication",
    texte:
      "Définition du positionnement, des objectifs et des piliers éditoriaux.",
  },
  {
    titre: "Réseaux sociaux",
    texte:
      "Planning de publication et création de contenus : carrousels, contenus pédagogiques et publications de sensibilisation.",
  },
];

const competences = [
  {
    domaine: "Comprendre",
    detail: "Analyser un marché, des concurrents et des cibles.",
    preuve: "étude de marché et veille du projet.",
  },
  {
    domaine: "Concevoir",
    detail:
      "Construire une stratégie de communication : positionnement, piliers éditoriaux, planning.",
    preuve: "stratégie éditoriale et planning de publication.",
  },
  {
    domaine: "Exprimer",
    detail: "Transformer un sujet complexe en contenus simples et visuels.",
    preuve: "carrousels et publications de sensibilisation.",
  },
];

const precedent = { nom: "WASHROLL", lien: "/projets/washroll" };
const suivant = { nom: "Tous les projets", lien: "/projets" };

/* Transforme 0, 1, 2 en "01", "02", "03" */
const numero = (i) => String(i + 1).padStart(2, "0");
---

<Layout title={`${projet.nom} | Rahma Hamdi`}>
  <div class="container">

    <!-- EN-TÊTE -->
    <section class="section">
      <a class="projet-retour" href="/projets">← Tous les projets</a>
      <p class="label">{projet.type}</p>
      <h1 class="projet-titre">{projet.nom}</h1>
      <p class="projet-accroche">{projet.accroche}</p>

      <dl class="projet-infos">
        {infos.map((info) => (
          <div>
            <dt>{info.label}</dt>
            <dd>{info.valeur}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- 01 PRÉSENTATION -->
    <section class="section">
      <h2 class="projet-h2"><span>01</span> Présentation</h2>

      <div class="projet-duo">
        <div class="projet-texte">
          <p>{projet.presentation}</p>
          <div class="projet-actions">
            <a class="pixel-btn" href={projet.lien} target="_blank" rel="noopener noreferrer">
              Voir le site ↗
            </a>
            <a class="pixel-btn" href={projet.instagram} target="_blank" rel="noopener noreferrer">
              Instagram ↗
            </a>
          </div>
        </div>

        <div class="projet-visuel">
          <img src="/images/captures/capture-zozzo.png" alt="Page d'accueil du site ZOZZO" />
        </div>
      </div>
    </section>

    <!-- 02 MON RÔLE -->
    <section class="section">
      <h2 class="projet-h2"><span>02</span> Mon rôle</h2>

      <div class="projet-missions">
        {missions.map((mission, i) => (
          <article class="pixel-panel projet-mission">
            <span class="projet-mission__num">{numero(i)}</span>
            <h3>{mission.titre}</h3>
            <p>{mission.texte}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 03 COMPÉTENCES MOBILISÉES -->
    <section class="section">
      <h2 class="projet-h2"><span>03</span> Compétences mobilisées</h2>

      <ul class="projet-competences">
        {competences.map((competence) => (
          <li class="pixel-panel projet-competence">
            <span class="label">{competence.domaine}</span>
            <p>{competence.detail}</p>
            <p class="projet-competence__preuve">Preuve : {competence.preuve}</p>
          </li>
        ))}
      </ul>

      <a class="pixel-btn" href="/competences">Toutes mes compétences</a>
    </section>

    <!-- NAVIGATION ENTRE PROJETS -->
    <nav class="projet-nav section" aria-label="Autres projets">
      <a href={precedent.lien}>← {precedent.nom}</a>
      <a href={suivant.lien}>{suivant.nom} →</a>
    </nav>

  </div>
</Layout>
