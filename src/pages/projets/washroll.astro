---
import Layout from "../../layouts/Layout.astro";
import "../../styles/projet.css";

/* ---------- Données du projet ---------- */
const projet = {
  nom: "WASHROLL",
  type: "Stratégie · UX",
  accroche:
    "Une application pour réserver sa machine à laver en résidence étudiante.",
  presentation:
    "WASHROLL permet aux étudiants en résidence de voir les machines disponibles, de réserver un créneau, de l'annuler ou de signaler une panne. Le paiement se fait sur place. Mon travail a porté sur toute la partie étude, avant la conception de l'application.",
  lien: "https://washroll.ayyobi.fr/",
};

const infos = [
  { label: "Cadre", valeur: "[À COMPLÉTER : SAÉ et année]" },
  { label: "Équipe", valeur: "[À COMPLÉTER : noms]" },
  { label: "Mon rôle", valeur: "Étude de marché, personas, analyse des besoins" },
];

const missions = [
  {
    titre: "Étude de marché",
    texte:
      "Recherche de chiffres sur la vie étudiante (Crous, OVE, Arcep) et de témoignages pour montrer que le besoin est réel.",
  },
  {
    titre: "Concurrence",
    texte:
      "Comparaison de trois solutions existantes : WeWash, appWash et WashOnline.",
  },
  {
    titre: "Personas",
    texte:
      "Création de deux profils : Sarah, étudiante de 20 ans à Montbéliard, et Mathieu, responsable de résidence de 43 ans à Besançon.",
  },
  {
    titre: "Analyse des besoins",
    texte:
      "Tableau qui relie chaque problème rencontré à une fonctionnalité de l'application.",
  },
];

const competences = [
  {
    domaine: "Comprendre",
    detail: "Étudier un marché et analyser la concurrence.",
    preuve: "comparatif WeWash / appWash / WashOnline du dossier.",
  },
  {
    domaine: "Comprendre",
    detail: "Identifier les utilisateurs et leurs besoins réels.",
    preuve: "deux personas (étudiante et responsable de résidence).",
  },
  {
    domaine: "Concevoir",
    detail: "Traduire des besoins en fonctionnalités.",
    preuve: "tableau problème → fonctionnalité.",
  },
];

const precedent = { nom: "OLYVIA", lien: "/projets/olyvia" };
const suivant = { nom: "ZOZZO", lien: "/projets/zozzo" };

/* Transforme 0, 1, 2 en "01", "02", "03" */
const numero = (i) => String(i + 1).padStart(2, "0");
---

<Layout title={`${projet.nom} | Rahma Hamdi`}>
  <div class="container">

    <!-- EN-TÊTE -->
    <section class="section">
      <a class="projet-retour" href="/projets">← Tous les projets</a>
      <p class="label">{projet.type}</p>
      <h1 class="projet-titre">{projet.nom}</h1>
      <p class="projet-accroche">{projet.accroche}</p>

      <dl class="projet-infos">
        {infos.map((info) => (
          <div>
            <dt>{info.label}</dt>
            <dd>{info.valeur}</dd>
          </div>
        ))}
      </dl>
    </section>

    <!-- 01 PRÉSENTATION -->
    <section class="section">
      <h2 class="projet-h2"><span>01</span> Présentation</h2>

      <div class="projet-duo">
        <div class="projet-texte">
          <p>{projet.presentation}</p>
          <div class="projet-actions">
            <a class="pixel-btn" href={projet.lien} target="_blank" rel="noopener noreferrer">
              Voir le site ↗
            </a>
          </div>
        </div>

        <div class="projet-visuel">
          <!-- Quand ta capture est dans public/images/projets/,
               enlève les commentaires autour de la ligne <img> -->
          <!-- <img src="/images/projets/washroll-site.png" alt="Écran d'accueil de l'application WASHROLL" /> -->
          <span>CAPTURE DU SITE</span>
        </div>
      </div>
    </section>

    <!-- 02 MON RÔLE -->
    <section class="section">
      <h2 class="projet-h2"><span>02</span> Mon rôle</h2>

      <div class="projet-missions">
        {missions.map((mission, i) => (
          <article class="pixel-panel projet-mission">
            <span class="projet-mission__num">{numero(i)}</span>
            <h3>{mission.titre}</h3>
            <p>{mission.texte}</p>
          </article>
        ))}
      </div>
    </section>

    <!-- 03 COMPÉTENCES MOBILISÉES -->
    <section class="section">
      <h2 class="projet-h2"><span>03</span> Compétences mobilisées</h2>

      <ul class="projet-competences">
        {competences.map((competence) => (
          <li class="pixel-panel projet-competence">
            <span class="label">{competence.domaine}</span>
            <p>{competence.detail}</p>
            <p class="projet-competence__preuve">Preuve : {competence.preuve}</p>
          </li>
        ))}
      </ul>

      <a class="pixel-btn" href="/competences">Toutes mes compétences</a>
    </section>

    <!-- NAVIGATION ENTRE PROJETS -->
    <nav class="projet-nav section" aria-label="Autres projets">
      <a href={precedent.lien}>← {precedent.nom}</a>
      <a href={suivant.lien}>{suivant.nom} →</a>
    </nav>

  </div>
</Layout>
