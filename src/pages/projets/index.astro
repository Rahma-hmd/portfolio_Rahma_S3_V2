---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { projets } from "../../data/projets.js";
---

<Layout title="Projets — Rahma Hamdi">
  <section class="container section">
    <p class="label">Sélection</p>
    <h1>Projets</h1>
    <p class="intro">
      Choisissez un projet pour découvrir ma démarche, de l'analyse jusqu'au résultat.
    </p>

    <div class="grille">
      {projets.map((projet, index) => (
        <ProjectCard
          nom={projet.nom}
          type={projet.type}
          resume={projet.resume}
          tags={projet.tags}
          href={`/projets/${projet.slug}`}
          delai={index * 100}
        />
      ))}
    </div>
  </section>
</Layout>

<style>
  h1 {
    margin-block: 0.75rem 1rem;
  }

  .intro {
    margin-bottom: 2.5rem;
  }

  .grille {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .grille { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .grille { grid-template-columns: repeat(3, 1fr); }
  }
</style>
