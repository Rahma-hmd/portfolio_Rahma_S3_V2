---
import Layout from "../layouts/Layout.astro";

const valeurs = [
  "Comprendre le besoin avant de créer.",
  "Une communication doit répondre à un objectif.",
  "Toucher la bonne cible, avec le bon message.",
];
---

<Layout title="À propos — Rahma Hamdi">
  <section class="container section apropos">
    <div class="apropos__image pixel-panel pixel-panel--orange" data-aos="fade-up">
      <img src="/images/avatar.png" alt="Avatar pixel art de Rahma Hamdi" width="320" height="320" />
    </div>

    <div class="apropos__texte" data-aos="fade-up" data-aos-delay="100">
      <p class="label">À propos</p>
      <h1>Moi, c'est Rahma</h1>
      <p>
        Je suis étudiante en deuxième année de BUT MMI (Métiers du Multimédia et de
        l'Internet).
      </p>
      <p>
        Ce qui m'intéresse le plus : comprendre un besoin, construire une stratégie de
        communication et la faire vivre à travers des contenus et des supports digitaux.
      </p>

      <h2>Ce qui me guide</h2>
      <ul class="valeurs">
        {valeurs.map((valeur) => <li>{valeur}</li>)}
      </ul>

      <div class="boutons">
        <a href="/competences" class="pixel-btn">Mes compétences →</a>
        <a href="/contact" class="pixel-btn">Me contacter →</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .apropos {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 860px) {
    .apropos { grid-template-columns: 320px 1fr; }
  }

  .apropos__image {
    padding: 1.5rem;
    max-width: 320px;
  }

  .apropos__image img {
    image-rendering: pixelated;
  }

  .apropos__texte {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  h2 {
    margin-top: 1.5rem;
    font-size: clamp(0.95rem, 1.8vw, 1.25rem);
    color: var(--orange);
  }

  .valeurs {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .valeurs li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .valeurs li::before {
    content: "";
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    background: var(--orange);
  }

  .boutons {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
