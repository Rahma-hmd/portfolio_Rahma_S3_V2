---
import { liens } from "../data/navigation.js";

const pageActuelle = Astro.url.pathname;

// Un lien est "actif" si on est sur sa page
function estActif(href) {
  if (href === "/") return pageActuelle === "/";
  return pageActuelle.startsWith(href);
}
---

<header class="header">
  <div class="container header__inner">
    <a href="/" class="logo">PORTFOLIO</a>

    <!-- Bouton burger : visible seulement sur mobile et tablette -->
    <button
      class="burger"
      type="button"
      aria-expanded="false"
      aria-controls="menu"
      aria-label="Ouvrir le menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="menu" class="menu" aria-label="Navigation principale">
      <ul class="nav">
        {liens.map((lien) => (
          <li>
            <a
              href={lien.href}
              class="nav__lien"
              aria-current={estActif(lien.href) ? "page" : undefined}
            >
              {lien.nom}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  // Ouvre / ferme le menu mobile
  const bouton = document.querySelector(".burger");
  const menu = document.querySelector(".menu");

  function fermerMenu() {
    menu.classList.remove("ouvert");
    bouton.setAttribute("aria-expanded", "false");
    bouton.setAttribute("aria-label", "Ouvrir le menu");
  }

  bouton.addEventListener("click", () => {
    const ouvert = menu.classList.toggle("ouvert");
    bouton.setAttribute("aria-expanded", ouvert);
    bouton.setAttribute("aria-label", ouvert ? "Fermer le menu" : "Ouvrir le menu");
  });

  // La touche Échap ferme le menu (accessibilité clavier)
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") fermerMenu();
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--orange);
    border-bottom: 4px solid var(--brun);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 0.9rem;
  }

  /* ---------- DESKTOP (par défaut) ---------- */
  .nav {
    display: flex;
    gap: 0.6rem;
    list-style: none;
  }

  .nav__lien {
    display: block;
    padding: 0.5rem 0.7rem;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    color: var(--brun);
    text-decoration: none;
    border: 3px solid var(--brun);
    transition: transform 0.1s steps(2);
  }

  .nav__lien:hover {
    transform: translateY(-2px);
    box-shadow: 3px 3px 0 var(--brun);
  }

  .nav__lien[aria-current="page"] {
    background: var(--brun);
    color: var(--orange);
  }

  /* Le burger est caché sur desktop */
  .burger {
    display: none;
  }

  /* ---------- TABLETTE + MOBILE (moins de 900 px) ---------- */
  @media (max-width: 900px) {
    /* Header plus fin */
    .header__inner {
      padding-block: 0.6rem;
      gap: 0.6rem;
    }

    /* Burger pixel : 3 barres carrées */
    .burger {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 40px;
      height: 40px;
      padding: 0 8px;
      background: var(--orange);
      border: 3px solid var(--brun);
      box-shadow: 3px 3px 0 var(--brun);
      cursor: pointer;
    }

    .burger span {
      height: 3px;
      background: var(--brun);
    }

    /* Bouton enfoncé quand le menu est ouvert */
    .burger[aria-expanded="true"] {
      background: var(--brun);
      box-shadow: none;
      transform: translate(3px, 3px);
    }

    .burger[aria-expanded="true"] span {
      background: var(--orange);
    }

    /* Le menu est caché tant qu'on n'a pas cliqué */
    .menu {
      display: none;
      width: 100%;
    }

    .menu.ouvert {
      display: block;
    }

    /* Les liens passent en colonne, pleine largeur */
    .nav {
      flex-direction: column;
      gap: 0.4rem;
      padding-block: 0.5rem 0.25rem;
      border-top: 3px dashed var(--brun);
    }

    .nav__lien {
      padding: 0.75rem 0.9rem;
      font-size: 0.625rem;
    }
  }
</style>
