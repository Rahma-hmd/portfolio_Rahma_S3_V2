---
import { liens } from "../data/navigation.js";

const annee = new Date().getFullYear();

/* Mes réseaux (icônes dans public/images/) */
const reseaux = [
  {
    nom: "LinkedIn",
    lien: "https://www.linkedin.com/in/rahma-hamdi-a26353328/",
    icone: "/images/linkedin.svg",
  },
  {
    nom: "Behance",
    lien: "https://www.behance.net/rahmahamdi3",
    icone: "/images/behance.svg",
  },
];
---

<footer class="footer">
  <div class="footer__inner">
    <!-- LOGO + COPYRIGHT -->
    <div class="footer__brand">
      <a href="/" class="footer__logo-link" aria-label="Retour à l'accueil">
        <img
          src="/images/logoportfolio.svg"
          alt="Portfolio Rahma Hamdi"
          class="footer__logo"
        />
      </a>
    </div>

    <!-- NAVIGATION -->
    <nav class="footer__nav" aria-label="Navigation pied de page">
      <ul class="footer__links">
        {liens.map((lien) => (
          <li><a href={lien.href}>{lien.nom}</a></li>
        ))}
      </ul>
    </nav>

    <!-- RÉSEAUX : LinkedIn + Behance -->
    <ul class="footer__reseaux">
      {reseaux.map((reseau) => (
        <li>
          <a
            href={reseau.lien}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${reseau.nom} (nouvel onglet)`}
          >
            <img src={reseau.icone} alt="" width="28" height="28" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    background: var(--orange);
    border-top: 2px solid var(--brun);
  }

  /* ---------- DESKTOP : logo à gauche, liens et icônes à droite ---------- */
  .footer__inner {
    width: min(100% - 2rem, 1400px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .footer__logo-link {
    display: block;
    line-height: 0;
  }

  .footer__logo {
    width: clamp(90px, 9vw, 120px);
    height: auto;
  }

  .footer__copyright {
    font-family: var(--font-pixel);
    font-size: 0.5625rem; /* 9 px */
    line-height: 1.4;
    color: var(--noir);
  }

  /* Pousse la navigation (et les icônes après elle) vers la droite */
  .footer__nav {
    margin-left: auto;
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap; /* les liens passent à la ligne au lieu de se chevaucher */
    justify-content: flex-end;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .footer__links a {
    font-family: var(--font-pixel);
    font-size: 0.625rem; /* 10 px */
    line-height: 1.4;
    color: var(--noir);
    text-decoration: none;
  }

  .footer__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* ---------- Icônes des réseaux ---------- */
  .footer__reseaux {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Case de 44 px : assez grande pour être touchée au doigt */
  .footer__reseaux a {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    background: var(--creme);
    border: 3px solid var(--noir);
    box-shadow: 3px 3px 0 var(--brun);
    transition: transform 0.15s steps(3), box-shadow 0.15s steps(3);
  }

  /* Au survol : la case se soulève et son ombre grandit */
  .footer__reseaux a:hover {
    transform: translate(-2px, -2px);
    box-shadow: 5px 5px 0 var(--brun);
  }

  .footer__reseaux a:focus-visible {
    outline: 3px solid var(--noir);
    outline-offset: 3px;
  }

  .footer__reseaux img {
    display: block;
    width: 28px;
    height: 28px;
    image-rendering: pixelated; /* garde les pixels nets */
  }

  /* ---------- MOBILE (moins de 700 px) : tout en colonne, centré ---------- */
  @media (max-width: 700px) {
    .footer {
      margin-top: 2.5rem;
    }

    .footer__inner {
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 1.25rem;
    }

    .footer__brand {
      align-items: center;
    }

    .footer__logo {
      width: 96px;
    }

    .footer__nav {
      margin-left: 0;
    }

    .footer__links {
      justify-content: center;
      gap: 0 0.25rem;
    }

    /* Zone de clic plus grande au doigt */
    .footer__links a {
      display: block;
      padding: 0.6rem 0.4rem;
      font-size: 0.5625rem; /* 9 px */
    }

    .footer__reseaux {
      justify-content: center;
    }
  }

  /* Pas d'animation pour les personnes qui les ont désactivées */
  @media (prefers-reduced-motion: reduce) {
    .footer__reseaux a {
      transition: none;
    }
  }
</style>
