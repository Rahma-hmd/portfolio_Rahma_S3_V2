---
import { liens } from "../data/navigation.js";

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <!-- LOGO + COPYRIGHT -->
    <div class="footer__brand">
      <a href="/" class="footer__logo-link" aria-label="Retour à l'accueil">
        <img
          src="/images/logoportfolio.svg"
          alt="Portfolio Rahma Hamdi"
          class="footer__logo"
        />
      </a>
      <p class="footer__copyright">{annee} © Rahma Hamdi</p>
    </div>

    <!-- NAVIGATION -->
    <nav class="footer__nav" aria-label="Navigation pied de page">
      <ul class="footer__links">
        {liens.map((lien) => (
          <li><a href={lien.href}>{lien.nom}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    background: var(--orange);
    border-top: 2px solid var(--brun);
  }

  /* ---------- DESKTOP : logo à gauche, liens à droite ---------- */
  .footer__inner {
    width: min(100% - 2rem, 1400px);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 1rem;
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .footer__logo-link {
    display: block;
    line-height: 0;
  }

  .footer__logo {
    width: clamp(90px, 9vw, 120px);
    height: auto;
  }

  .footer__copyright {
    font-family: var(--font-pixel);
    font-size: 0.5625rem; /* 9 px */
    line-height: 1.4;
    color: var(--noir);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap; /* les liens passent à la ligne au lieu de se chevaucher */
    justify-content: flex-end;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .footer__links a {
    font-family: var(--font-pixel);
    font-size: 0.625rem; /* 10 px */
    line-height: 1.4;
    color: var(--noir);
    text-decoration: none;
  }

  .footer__links a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  /* ---------- MOBILE (moins de 700 px) : tout en colonne, centré ---------- */
  @media (max-width: 700px) {
    .footer {
      margin-top: 2.5rem;
    }

    .footer__inner {
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 1.25rem;
    }

    .footer__brand {
      align-items: center;
    }

    .footer__logo {
      width: 96px;
    }

    .footer__links {
      justify-content: center;
      gap: 0 0.25rem;
    }

    /* Zone de clic plus grande au doigt */
    .footer__links a {
      display: block;
      padding: 0.6rem 0.4rem;
      font-size: 0.5625rem; /* 9 px */
    }
  }
</style>
