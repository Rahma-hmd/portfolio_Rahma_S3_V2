---
import { liens } from "../data/navigation.js";

const annee = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <a href="/" class="logo">PORTFOLIO</a>
      <p class="footer__copy">{annee} © Rahma Hamdi</p>
    </div>

    <nav aria-label="Pied de page">
      <ul class="footer__liens">
        {liens.map((lien) => (
          <li><a href={lien.href}>{lien.nom}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    margin-top: 4rem;
    background: var(--orange);
    color: var(--brun);
    border-top: 4px solid var(--brun);
  }

  .footer__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding-block: 1.75rem;
  }

  .footer__copy {
    margin-top: 0.5rem;
    font-family: var(--font-pixel);
    font-size: 0.625rem;
  }

  .footer__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
  }

  .footer__liens a {
    font-family: var(--font-pixel);
    font-size: 0.625rem;
    color: var(--brun);
    text-decoration: none;
  }

  .footer__liens a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
</style>
