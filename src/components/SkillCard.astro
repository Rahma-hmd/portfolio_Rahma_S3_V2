---
// Composant réutilisable : une carte = un domaine du BUT MMI.
// Les infos changent (props), mais la structure reste la même.
import PixelIcon from "./PixelIcon.astro";

const { number, title, subtitle, description, skills, icon, projet, delai = 0 } =
  Astro.props;
---

<article class="carte pixel-panel" data-aos="fade-up" data-aos-delay={delai}>
  <div class="carte__haut">
    <span class="carte__numero">[ {number} ]</span>
    <PixelIcon grille={icon} />
  </div>

  <h3 class="carte__titre">{title}</h3>
  <p class="carte__sous-titre">{subtitle}</p>
  <p class="carte__description">{description}</p>

  <p class="label carte__label">Compétences</p>
  <ul class="carte__liste">
    {skills.map((skill) => <li class="competence">{skill}</li>)}
  </ul>

  {projet && (
    <div class="carte__projet">
      <p class="carte__exemple">
        <strong>{projet.nom}</strong> — {projet.detail}
      </p>
      <a href={projet.href} class="pixel-btn">Voir un projet →</a>
    </div>
  )}
</article>

<style>
  .carte {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.75rem 1.5rem;
  }

  .carte__haut {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
    color: var(--orange);
  }

  .carte__numero {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
  }

  .carte__titre {
    color: var(--creme);
  }

  .carte__sous-titre {
    font-weight: 600;
    color: var(--orange);
  }

  .carte__description {
    font-size: 1rem;
    opacity: 0.85;
  }

  .carte__label {
    margin-top: 0.5rem;
  }

  .carte__liste {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    list-style: none;
  }

  /* Une compétence : petit carré pixel devant */
  .competence {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.3rem 0.5rem;
    font-size: 0.95rem;
    transition: transform 0.1s steps(2), box-shadow 0.1s steps(2);
  }

  .competence::before {
    content: "";
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    margin-inline: 3px;
    background: var(--orange);
  }

  /* Au survol : monte de 2 px + ombre pixel + le carré devient une étoile */
  .competence:hover {
    transform: translateY(-2px);
    background: rgba(226, 169, 82, 0.1);
    box-shadow: 3px 3px 0 var(--orange);
  }

  .competence:hover::before {
    width: 4px;
    height: 4px;
    margin-inline: 4px;
    box-shadow:
      4px 0 var(--orange),
      -4px 0 var(--orange),
      0 4px var(--orange),
      0 -4px var(--orange);
  }

  .carte__projet {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 2px dashed rgba(255, 237, 224, 0.2);
  }

  .carte__exemple {
    font-size: 0.9rem;
  }
</style>
